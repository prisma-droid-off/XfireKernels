# Maintener
CONFIG_LOCALVERSION="@prisma-droid"
CONFIG_LOCALVERSION_AUTO is not set

# BakaSU
CONFIG_KSU=y
# CONFIG_KALLSYMS is not set
# CONFIG_KSU_MANUAL_HOOK is not set

# DEVICES / DOCKER
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_HUGETLBFS=y
CONFIG_SECURITY_APPARMOR=y

# NFTABLES
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y

# CGROUPS
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_MISC=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_RDMA=y

# LXC
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_FHANDLE=y

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# HW Access Support
CONFIG_DEVTMPFS=y

# Fix for docker unsafe procfs error
CONFIG_USER_NS=y

# Enable xattr, posix acl support on tmpfs
# For NixOS support
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Resource limits:
CONFIG_CFS_BANDWIDTH=y

# UFW support / IPv6 in NAT mode
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NFT_NAT=y
CONFIG_IP6_NF_NAT=y

# Device management
CONFIG_DEVTMPFS_MOUNT=y

#BRIDGE
CONFIG_BRIDGE_VLAN_FILTERING=y

# Firmware loading
CONFIG_FW_LOADER_COMPRESS=y

# Networking (Enhanced NAT support)
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# == Modules (vendor_dlkm) ==

# Netfilter_XT
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NETFILTER_XT_SET=m

# NET_CLS
CONFIG_NET_CLS_CGROUP=m

# Macvlan mode (--net=macvlan)
CONFIG_MACVLAN=m

# IP_SCTP
CONFIG_IP_SCTP=m
CONFIG_VXLAN=m

# NFT_FIB
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB=m

# IP_VS
CONFIG_IP_VS=m
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y

# Fail2ban support
CONFIG_IP_SET=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_NET=m

# BRIDGE
CONFIG_BRIDGE_NETFILTER=m

# BTRFS
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y

# NF_TABLES
CONFIG_NFT_MASQ=m
CONFIG_NFT_CT=m
CONFIG_NF_TABLES=m

# Socket Monitor
CONFIG_UNIX_DIAG=m
CONFIG_PACKET_DIAG=m
CONFIG_NETLINK_DIAG=m

# == Disable Samsung Securities ==
# CONFIG_UH is not set
# CONFIG_UH_RKP is not set
# CONFIG_UH_LKMAUTH is not set
# CONFIG_UH_LKM_BLOCK is not set
# CONFIG_RKP_CFP_JOPP is not set
# CONFIG_RKP_CFP_ROPP is not set
# CONFIG_RKP_CFP is not set
# CONFIG_SECURITY_DEFEX is not set
# CONFIG_PROCA is not set
# CONFIG_FIVE is not set

# == Optimizations / Features

# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_BTF is not set

CONFIG_FRAME_WARN=0
CONFIG_KEXEC=y
CONFIG_NTSYNC=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR3=y