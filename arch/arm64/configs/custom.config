# Maintener
CONFIG_LOCALVERSION="@prisma-droid"
CONFIG_LOCALVERSION_AUTO=n

# BakaSU
CONFIG_KSU=y
CONFIG_KALLSYMS=y
CONFIG_KSU_MANUAL_HOOK=n

# Kernel configurations for full DroidSpaces support for GKI
# Copyright (C) 2026 ravindu644 <droidcasts@protonmail.com>

# DEVICES / DOCKER
CONFIG_CGROUP_DEVICE=y
CONFIG_VXLAN=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_IP_SCTP=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_HUGETLBFS=y
CONFIG_SECURITY_APPARMOR=y

# NFTABLES
CONFIG_NF_TABLES=y
NF_TABLES_IPV6=y
NFT_FIB_IPV4=y
NFT_FIB_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_CT=y

# CGROUPS
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_MISC=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_RDMA=y

# LXC
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_FHANDLE=y

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# HW Access Support
CONFIG_DEVTMPFS=y

# Fix for docker unsafe procfs error
CONFIG_USER_NS=y

# Enable xattr, posix acl support on tmpfs
# For NixOS support
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Resource limits:
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y

# Socket Monitor
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y

# UFW support / IPv6 in NAT mode
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_NAT=y

# Fail2ban support
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y

# BTRFS
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y

# Terminal support (required for login)
CONFIG_DEVPTS_FS=y

# Device management
CONFIG_DEVTMPFS_MOUNT=y

#BRIDGE
CONFIG_BRIDGE_VLAN_FILTERING=y

# Firmware loading
CONFIG_FW_LOADER_COMPRESS=y

# Networking (Enhanced NAT support)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_SET=y

# == Modules (vendor_dlkm) ==

# Macvlan mode (--net=macvlan)
CONFIG_MACVLAN=m

# IP_VS
CONFIG_IP_VS=m
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y

# BRIDGE
CONFIG_BRIDGE_NETFILTER=m

# == Disable Samsung Securities ==
CONFIG_UH=n
CONFIG_UH_RKP=n
CONFIG_UH_LKMAUTH=n
CONFIG_UH_LKM_BLOCK=n
CONFIG_RKP_CFP_JOPP=n
CONFIG_RKP_CFP_ROPP=n
CONFIG_RKP_CFP=n
CONFIG_SECURITY_DEFEX=n
CONFIG_PROCA=n
CONFIG_FIVE=n

# == Optimizations / Features

# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_BTF is not set

CONFIG_FRAME_WARN=0
CONFIG_KEXEC=y
CONFIG_NTSYNC=y
CONFIG_TCP_CONG_BBR3=y