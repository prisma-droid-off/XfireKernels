#!/system/bin/sh
#
# lkmctl - control interface for Custom LKM Loader
# Copyright (c) 2026 @prisma_alt
# Credits to ravindu644 for the original LKM Loader concept
#
set -u

MODDIR=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)
KMOD_DIR="$MODDIR/system/vendor/lib/modules/custom"
STATE_DIR="${LKMCTL_STATE_DIR:-/data/adb/lkm_loader}"
KNOWN_FILE="$STATE_DIR/known"
PIN_FILE="$STATE_DIR/pinned"
BOOT_LOG="$STATE_DIR/boot.log"
PROC_MODULES="${LKMCTL_PROC_MODULES:-/proc/modules}"

MODPROBE="${LKMCTL_MODPROBE:-$(command -v modprobe 2>/dev/null || true)}"
[ -n "${MODPROBE:-}" ] || MODPROBE=/system/bin/modprobe

mkdir -p "$STATE_DIR" 2>/dev/null
[ -f "$KNOWN_FILE" ] || : > "$KNOWN_FILE"
[ -f "$PIN_FILE" ]   || : > "$PIN_FILE"

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

json_escape() {
    printf '%s' "$1" | tr '\n\r\t' '   ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

emit() {
    if [ "${LKMCTL_PLAIN:-0}" = "1" ]; then
        printf '%s\n' "$2"
    else
        printf '{"ok":%s,"message":"%s"}\n' "$1" "$(json_escape "$2")"
    fi
}

norm() { printf '%s' "$1" | tr '-' '_'; }

is_loaded() {
    [ -r "$PROC_MODULES" ] || return 1
    want=$(norm "$1")
    awk -v m="$want" '
        { n = $1; gsub(/-/, "_", n); if (n == m) { f = 1; exit } }
        END { exit(f ? 0 : 1) }
    ' "$PROC_MODULES"
}

is_pinned() { grep -qxF -- "$1" "$PIN_FILE"; }

all_names() {
    for f in "$KMOD_DIR"/*.ko; do
        [ -e "$f" ] || continue
        n=${f##*/}
        printf '%s\n' "${n%.ko}"
    done
}

# load order: modules.load first (dependency order), then anything unlisted
ordered_names() {
    if [ -f "$KMOD_DIR/modules.load" ]; then
        while IFS= read -r line; do
            line=${line%%#*}
            line=$(printf '%s' "$line" | tr -d ' \t\r')
            [ -n "$line" ] || continue
            case "$line" in *.ko) line=${line%.ko} ;; esac
            printf '%s\n' "$line"
        done < "$KMOD_DIR/modules.load"
    fi
    all_names
}

reverse_lines() { sed '1!G;h;$!d'; }

# new modules are only recorded as known: nothing loads at boot until the
# user pins it, and explicit pin choices persist across module updates.
# one awk pass instead of grep per module keeps UI actions fast.
sync_known() {
    n=$(wc -l < "$KNOWN_FILE" 2>/dev/null || echo 0)
    all_names | awk -v n="$n" 'NR <= n { known[$0] = 1; next } !($0 in known)' \
        "$KNOWN_FILE" - >> "$KNOWN_FILE"
}

valid_name() {
    case "${1:-}" in
        ""|*/*|*..*) return 1 ;;
        *[!A-Za-z0-9_.+@-]*) return 1 ;;
    esac
    [ -f "$KMOD_DIR/$1.ko" ]
}

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

cmd_list() {
    all_names | awk -v pin="$PIN_FILE" -v proc="$PROC_MODULES" '
        BEGIN {
            while ((getline line < pin) > 0) if (line != "") p[line] = 1
            while ((getline line < proc) > 0) {
                split(line, f, " ")
                n = f[1]; gsub(/-/, "_", n); ld[n] = 1
            }
        }
        {
            key = $0; gsub(/-/, "_", key)
            total++
            pl = ($0 in p); ll = (key in ld)
            if (pl) pinned++
            if (ll) loaded++
            items = items (total > 1 ? "," : "") "{\"name\":\"" $0 "\",\"loaded\":" (ll ? "true" : "false") ",\"pinned\":" (pl ? "true" : "false") "}"
        }
        END { printf "{\"modules\":[%s],\"total\":%d,\"loaded\":%d,\"pinned\":%d}\n", items, total + 0, loaded + 0, pinned + 0 }
    '
}

cmd_load() {
    n=${1:-}
    valid_name "$n" || { emit false "module not found: ${n:-?}"; return 1; }
    if is_loaded "$n"; then emit true "$n is already loaded"; return 0; fi
    out=$("$MODPROBE" -d "$KMOD_DIR" "$n" 2>&1); rc=$?
    if [ $rc -eq 0 ]; then
        emit true "loaded $n"
    else
        emit false "failed to load $n: $out"
    fi
    return $rc
}

cmd_unload() {
    n=${1:-}
    valid_name "$n" || { emit false "module not found: ${n:-?}"; return 1; }
    if ! is_loaded "$n"; then emit true "$n is not loaded"; return 0; fi
    out=$("$MODPROBE" -r -d "$KMOD_DIR" "$n" 2>&1); rc=$?
    if [ $rc -eq 0 ]; then
        emit true "unloaded $n"
    else
        emit false "failed to unload $n (in use?): $out"
    fi
    return $rc
}

cmd_pin() {
    n=${1:-}
    valid_name "$n" || { emit false "module not found: ${n:-?}"; return 1; }
    is_pinned "$n" || printf '%s\n' "$n" >> "$PIN_FILE"
    emit true "$n pinned to boot"
}

cmd_unpin() {
    n=${1:-}
    valid_name "$n" || { emit false "module not found: ${n:-?}"; return 1; }
    if is_pinned "$n"; then
        grep -vxF -- "$n" "$PIN_FILE" > "$PIN_FILE.tmp" 2>/dev/null
        mv "$PIN_FILE.tmp" "$PIN_FILE"
    fi
    emit true "$n removed from boot"
}

cmd_loadpins() {
    [ -f "$BOOT_LOG" ] && : > "$BOOT_LOG"
    sync_known
    cnt=0; okn=0; failed=0
    errs=""
    for n in $(ordered_names); do
        is_pinned "$n" || continue
        [ -f "$KMOD_DIR/$n.ko" ] || continue
        is_loaded "$n" && continue
        cnt=$((cnt + 1))
        out=$("$MODPROBE" -d "$KMOD_DIR" "$n" 2>&1); rc=$?
        if [ $rc -eq 0 ]; then
            okn=$((okn + 1))
            printf 'ok   %s\n' "$n" >> "$BOOT_LOG"
        else
            failed=$((failed + 1))
            errs="$errs $n"
            printf 'fail %s: %s\n' "$n" "$out" >> "$BOOT_LOG"
        fi
    done
    if [ $failed -eq 0 ]; then
        emit true "loaded $okn pinned module(s)"
    else
        emit false "loaded $okn, failed $failed:$errs"
    fi
    [ $failed -eq 0 ]
}

cmd_loadall() {
    sync_known
    okn=0; errs=""
    pass=0
    while [ $pass -lt 3 ]; do
        pass=$((pass + 1))
        progress=0; errs=""
        for n in $(ordered_names); do
            [ -f "$KMOD_DIR/$n.ko" ] || continue
            is_loaded "$n" && continue
            if "$MODPROBE" -d "$KMOD_DIR" "$n" >/dev/null 2>&1; then
                okn=$((okn + 1)); progress=1
            else
                errs="$errs $n"
            fi
        done
        [ -z "$errs" ] && break
        [ $progress -eq 0 ] && break
    done
    if [ -z "$errs" ]; then
        emit true "loaded $okn module(s)"
    else
        emit false "loaded $okn, failed:$errs"
    fi
    [ -z "$errs" ]
}

# modules hold references to each other, so retry passes release dependents
# first (e.g. sctp_diag keeps sctp busy) instead of giving up on first failure
cmd_unloadall() {
    okn=0
    pass=0
    while [ $pass -lt 4 ]; do
        pass=$((pass + 1))
        progress=0
        for n in $(ordered_names | reverse_lines); do
            [ -f "$KMOD_DIR/$n.ko" ] || continue
            is_loaded "$n" || continue
            if "$MODPROBE" -r -d "$KMOD_DIR" "$n" >/dev/null 2>&1; then
                okn=$((okn + 1)); progress=1
            fi
        done
        [ $progress -eq 0 ] && break
    done
    remaining=""
    for n in $(ordered_names); do
        [ -f "$KMOD_DIR/$n.ko" ] || continue
        is_loaded "$n" && remaining="$remaining $n"
    done
    if [ -z "$remaining" ]; then
        emit true "unloaded $okn module(s)"
        return 0
    fi
    emit false "still in use:$remaining"
    return 1
}

cmd_pinall() {
    for f in "$KMOD_DIR"/*.ko; do
        [ -e "$f" ] || continue
        n=${f##*/}; n=${n%.ko}
        is_pinned "$n" || printf '%s\n' "$n" >> "$PIN_FILE"
        grep -qxF -- "$n" "$KNOWN_FILE" || printf '%s\n' "$n" >> "$KNOWN_FILE"
    done
    emit true "all modules pinned to boot"
}

cmd_unpinall() {
    : > "$PIN_FILE"
    emit true "boot pin list cleared"
}

cmd_sync() {
    sync_known
    emit true "module list synchronized"
}

cmd_status() {
    loaded=0; pinned=0; total=0
    for f in "$KMOD_DIR"/*.ko; do
        [ -e "$f" ] || continue
        n=${f##*/}; n=${n%.ko}
        total=$((total + 1))
        is_loaded "$n" && loaded=$((loaded + 1))
        is_pinned "$n" && pinned=$((pinned + 1))
    done
    emit true "total=$total loaded=$loaded pinned=$pinned"
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

case "${1:-}" in
    list)       cmd_list ;;
    load)       shift; cmd_load "${1:-}" ;;
    unload)     shift; cmd_unload "${1:-}" ;;
    pin)        shift; cmd_pin "${1:-}" ;;
    unpin)      shift; cmd_unpin "${1:-}" ;;
    loadpins|apply) cmd_loadpins ;;
    loadall)    cmd_loadall ;;
    unloadall)  cmd_unloadall ;;
    pinall)     cmd_pinall ;;
    unpinall)   cmd_unpinall ;;
    sync)       cmd_sync ;;
    status)     cmd_status ;;
    *)
        printf 'usage: %s {list|load <mod>|unload <mod>|pin <mod>|unpin <mod>|loadpins|loadall|unloadall|pinall|unpinall|sync|status}\n' "$0" >&2
        exit 2
        ;;
esac
